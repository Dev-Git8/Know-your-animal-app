# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL (Recommended for Production & Cloud Hosting):
# Format: postgresql://<username>:<password>@<host>:<port>/<dbname>?sslmode=require
# Examples:
#   Neon:     postgresql://user:pass@ep-cool-forest.us-east-2.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres:pass@db.xxxx.supabase.co:5432/postgres
#   Local:    postgresql://postgres:pass@localhost:5432/knowyouranimal
DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require

# SQLite (Local Development Fallback):
# DATABASE_URL=sqlite:///app.db

# MongoDB (Atlas Cluster - optional / alternative Node.js backend):
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/animal

# AI Veterinary Assistant (Google Gemini API Key)
GEMINI_API_KEY=your_gemini_api_key_here

